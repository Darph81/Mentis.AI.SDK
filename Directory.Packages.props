<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    License policy (same as Mentis.AI.Manager): only permissive open-source
    licenses (MIT, Apache-2.0, BSD). Copyleft (GPL/LGPL/AGPL) is forbidden.
    Check every new package's license before adding it here.

    Keep gRPC/Protobuf versions aligned with Mentis.AI.Manager's
    Directory.Packages.props. No prerelease packages.
  -->

  <ItemGroup Label="gRPC (Apache-2.0 / BSD-3-Clause)">
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.80.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.31.1" />
  </ItemGroup>

  <ItemGroup Label="Dependency injection / options (MIT) - only for AddMentisClient()">
    <!-- Deliberately the lowest 10.0 version: this is the minimum every consumer is forced to, so keep it low
         as long as `dotnet list package --vulnerable --include-transitive` is clean. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Tests (MIT / BSD)">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <!-- FluentAssertions is not MIT since v8 -> deliberately not used. -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
