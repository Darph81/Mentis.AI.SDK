<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Mentis.AI.Sdk</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <PackageId>Mentis.AI.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Description>Lightweight, async-only .NET client for the Mentis.AI Manager: documents, conversations and billing.</Description>
    <PackageTags>mentis;ai;llm;rag;grpc;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Darph81/Mentis.AI.SDK</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/Darph81/Mentis.AI.SDK/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 Darph81</Copyright>

    <!-- Source link: lets debuggers step into the SDK's source on GitHub (SourceLink ships with the .NET SDK). -->
    <RepositoryUrl>https://github.com/Darph81/Mentis.AI.SDK.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <!-- The generated gRPC messages and clients come from the Manager's contract package. They are an implementation
         detail (the public API uses SDK-owned models), so their compile assets do not flow to consumers; the
         package and its runtime assets still do. -->
    <PackageReference Include="Mentis.AI.Contracts" PrivateAssets="compile" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mentis.AI.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
